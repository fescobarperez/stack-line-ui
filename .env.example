# ─── Cliente (Vite) ──────────────────────────────────────────
VITE_APP_NAME=Stackline
VITE_DEFAULT_BRANCH=Sucursal Zona 10
VITE_CURRENCY=GTQ
VITE_TAX_RATE=0.12

# ─── Microservicios (registro en el front, ver src/api/services.js) ──
# URL base de cada microservicio. Vacío = mismo origen: usa el proxy de Vite en
# dev y el gateway/reverse-proxy en prod. Prod ej.: https://api.tudominio.com
VITE_SVC_CORE=
VITE_SVC_VENTAS=
VITE_SVC_COMPRAS=
VITE_SVC_CONTA=
VITE_SVC_FEL=
VITE_SVC_RRHH=
VITE_SVC_ADMIN=
# Target del proxy de Vite por servicio en DEV. Hoy todos apuntan al mismo
# backend local (:8080); repunta el que separes cuando toque.
VITE_DEV_CORE_TARGET=http://localhost:8080
VITE_DEV_VENTAS_TARGET=http://localhost:8080
VITE_DEV_COMPRAS_TARGET=http://localhost:8080
VITE_DEV_CONTA_TARGET=http://localhost:8080
VITE_DEV_FEL_TARGET=http://localhost:8080
VITE_DEV_RRHH_TARGET=http://localhost:8080
VITE_DEV_ADMIN_TARGET=http://localhost:8080

# ─── Servidor (Express) ──────────────────────────────────────
PORT=4000
NODE_ENV=development
DB_PATH=./server/data/erp_maya.db
CORS_ORIGIN=http://localhost:5173
